# ── Supabase ─────────────────────────────────────────────
# Значения берутся в панели Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ваш-anon-public-ключ

# service_role используется ТОЛЬКО на сервере (никогда не попадает в браузер).
# ОБЯЗАТЕЛЕН для Telegram Mini App (/tg): сайт работает от имени клиента,
# личность которого подтверждена подписью Telegram.
SUPABASE_SERVICE_ROLE_KEY=ваш-service-role-ключ

# ── Telegram ─────────────────────────────────────────────
# Токен бота от @BotFather. Нужен и для уведомлений, и для Mini App
# (по нему проверяется подлинность входа пользователя).
TELEGRAM_BOT_TOKEN=
# Чат/канал для уведомлений о новых заявках (необязательно)
TELEGRAM_CHAT_ID=

# ── Прочее ───────────────────────────────────────────────
# Публичный адрес сайта (для писем-подтверждений Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
