# ── Supabase ─────────────────────────────────────────────
# Значения берутся в панели Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ваш-anon-public-ключ

# service_role используется ТОЛЬКО на сервере (никогда не попадает в браузер).
SUPABASE_SERVICE_ROLE_KEY=ваш-service-role-ключ

# ── Уведомления в Telegram (бот randan.com) ──────────────
# Токен бота от @BotFather и chat_id чата/канала, куда слать уведомления.
# Оставьте пустыми, чтобы отключить уведомления — сайт продолжит работать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Прочее ───────────────────────────────────────────────
# Публичный адрес сайта (для писем-подтверждений Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
